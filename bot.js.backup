            .addFields(
                { 
                    name: 'âś… á´ˇá´‡Ę€ĘŹęś°ÉŞá´‹á´€á´„á´Šá´€', 
                    value: 'á´€Ę™ĘŹ á´˘ĘŹsá´‹á´€á´„Ě á´…á´Źsá´›á´‡Ě¨á´ á´…á´Ź sá´‡Ę€á´ˇá´‡Ę€á´€:\n1. á´Ę€á´˘á´‡á´„á´˘ĘŹá´›á´€á´Š Ę€á´‡É˘á´śĘźá´€á´ŤÉŞÉ´\n2. á´‹ĘźÉŞá´‹É´ÉŞá´Š á´Ę€á´˘ĘŹá´„ÉŞsá´‹ á´ˇá´‡Ę€ĘŹęś°ÉŞá´‹á´€á´„á´ŠÉŞ\n3. á´„ÉŞá´‡sá´˘ sÉŞá´‡Ě¨ É˘Ę€á´€Ě¨!', 
