            .setTimestamp();

        await message.channel.send({ embeds: [regulaminEmbed1, regulaminEmbed2, regulaminEmbed3] });
        message.delete().catch(() => {});
    }

    // Komenda: !mute
    if (command === 'mute') {
        if (!message.member.permissions.has(PermissionFlagsBits.ModerateMembers)) {
            return message.reply('âťŚ Nie masz uprawnieĹ„ do wyciszania czĹ‚onkĂłw!');
        }

        const member = message.mentions.members.first();
        const duration = args[1] || '10m';
        const reason = args.slice(2).join(' ') || 'Brak powodu';

        if (!member) {
            return message.reply('âťŚ Oznacz uĹĽytkownika do wyciszenia! UĹĽycie: `!mute @uĹĽytkownik 10m powĂłd`');
        }

        if (member.permissions.has(PermissionFlagsBits.Administrator)) {
            return message.reply('âťŚ Nie moĹĽesz wyciszyÄ‡ administratora!');
        }

        // Konwersja czasu
        const timeMatch = duration.match(/^(\d+)([smhd])$/);
        if (!timeMatch) {
            return message.reply('âťŚ NieprawidĹ‚owy format czasu! UĹĽyj: 10s, 5m, 2h, 1d');
        }

        const timeValue = parseInt(timeMatch[1]);
        const timeUnit = timeMatch[2];
        let milliseconds;

        switch (timeUnit) {
            case 's': milliseconds = timeValue * 1000; break;
            case 'm': milliseconds = timeValue * 60 * 1000; break;
            case 'h': milliseconds = timeValue * 60 * 60 * 1000; break;
            case 'd': milliseconds = timeValue * 24 * 60 * 60 * 1000; break;
        }

        try {
            await member.timeout(milliseconds, reason);

            const muteEmbed = new EmbedBuilder()
                .setColor('#FFA500')
                .setTitle('đź”‡ UĹĽytkownik wyciszony')
                .addFields(
                    { name: 'UĹĽytkownik', value: `${member.user.tag}`, inline: true },
                    { name: 'Moderator', value: `${message.author.tag}`, inline: true },
                    { name: 'Czas', value: duration, inline: true },
                    { name: 'PowĂłd', value: reason, inline: false }
                )
                .setTimestamp();

            message.reply({ embeds: [muteEmbed] });

            // Log
            const logsChannel = message.guild.channels.cache.get(process.env.LOGS_CHANNEL_ID);
            if (logsChannel) {
                logsChannel.send({ embeds: [muteEmbed] });
            }
        } catch (error) {
            message.reply('âťŚ Nie udaĹ‚o siÄ™ wyciszyÄ‡ uĹĽytkownika!');
            console.error(error);
        }
    }

    // Komenda: !unmute
    if (command === 'unmute') {
        if (!message.member.permissions.has(PermissionFlagsBits.ModerateMembers)) {
            return message.reply('âťŚ Nie masz uprawnieĹ„ do odciszania czĹ‚onkĂłw!');
        }

        const member = message.mentions.members.first();
        if (!member) {
            return message.reply('âťŚ Oznacz uĹĽytkownika do odciszenia! UĹĽycie: `!unmute @uĹĽytkownik`');
        }

        try {
            await member.timeout(null);
            message.reply(`âś… ${member.user.tag} zostaĹ‚ odciszony!`);
        } catch (error) {
            message.reply('âťŚ Nie udaĹ‚o siÄ™ odciszyÄ‡ uĹĽytkownika!');
        }
    }

    // Komenda: !kick
    if (command === 'kick' || command === 'wyrzuÄ‡') {
        if (!message.member.permissions.has(PermissionFlagsBits.KickMembers)) {
            return message.reply('âťŚ Nie masz uprawnieĹ„ do wyrzucania czĹ‚onkĂłw!');
        }

        const member = message.mentions.members.first();
        const reason = args.slice(1).join(' ') || 'Brak powodu';

        if (!member) {
            return message.reply('âťŚ Oznacz uĹĽytkownika do wyrzucenia! UĹĽycie: `!kick @uĹĽytkownik powĂłd`');
        }

        if (!member.kickable) {
            return message.reply('âťŚ Nie mogÄ™ wyrzuciÄ‡ tego uĹĽytkownika!');
        }

        try {
            await member.kick(reason);

            const kickEmbed = new EmbedBuilder()
                .setColor('#FF8800')
                .setTitle('đź‘˘ UĹĽytkownik wyrzucony')
                .addFields(
                    { name: 'UĹĽytkownik', value: `${member.user.tag}`, inline: true },
                    { name: 'Moderator', value: `${message.author.tag}`, inline: true },
                    { name: 'PowĂłd', value: reason, inline: false }
                )
                .setTimestamp();

            message.reply({ embeds: [kickEmbed] });

            // Log
            const logsChannel = message.guild.channels.cache.get(process.env.LOGS_CHANNEL_ID);
            if (logsChannel) {
                logsChannel.send({ embeds: [kickEmbed] });
            }
        } catch (error) {
            message.reply('âťŚ Nie udaĹ‚o siÄ™ wyrzuciÄ‡ uĹĽytkownika!');
            console.error(error);
        }
    }

    // Komenda: !ban
    if (command === 'ban') {
        if (!message.member.permissions.has(PermissionFlagsBits.BanMembers)) {
            return message.reply('âťŚ Nie masz uprawnieĹ„ do banowania czĹ‚onkĂłw!');
        }

        const member = message.mentions.members.first();
        const reason = args.slice(1).join(' ') || 'Brak powodu';

        if (!member) {
            return message.reply('âťŚ Oznacz uĹĽytkownika do zbanowania! UĹĽycie: `!ban @uĹĽytkownik powĂłd`');
        }

        if (!member.bannable) {
            return message.reply('âťŚ Nie mogÄ™ zbanowaÄ‡ tego uĹĽytkownika!');
        }

        try {
            await member.ban({ reason });

            const banEmbed = new EmbedBuilder()
                .setColor('#FF0000')
                .setTitle('đź”¨ UĹĽytkownik zbanowany')
                .addFields(
                    { name: 'UĹĽytkownik', value: `${member.user.tag}`, inline: true },
                    { name: 'Moderator', value: `${message.author.tag}`, inline: true },
                    { name: 'PowĂłd', value: reason, inline: false }
                )
                .setTimestamp();

            message.reply({ embeds: [banEmbed] });

            // Log
            const logsChannel = message.guild.channels.cache.get(process.env.LOGS_CHANNEL_ID);
            if (logsChannel) {
                logsChannel.send({ embeds: [banEmbed] });
            }
        } catch (error) {
            message.reply('âťŚ Nie udaĹ‚o siÄ™ zbanowaÄ‡ uĹĽytkownika!');
            console.error(error);
        }
    }

    // Komenda: !help
    if (command === 'help' || command === 'pomoc') {
        const helpEmbed = new EmbedBuilder()
            .setColor('#0099FF')
            .setTitle('đź“š Lista Komend')
            .setDescription('Wszystkie dostÄ™pne komendy bota')
            .addFields(
                { name: 'đź‘Ą OgĂłlne', value: '`!members` - Statystyki serwera\n`!help` - Ta wiadomoĹ›Ä‡', inline: false },
                { name: 'đź”¨ Moderacja', value: '`!mute @user 10m powĂłd` - Wycisz uĹĽytkownika\n`!unmute @user` - Odcisz uĹĽytkownika\n`!kick @user powĂłd` - WyrzuÄ‡ uĹĽytkownika\n`!ban @user powĂłd` - Zbanuj uĹĽytkownika', inline: false },
                { name: 'âš™ď¸Ź Administracja', value: '`!setup-verification` - UtwĂłrz panel weryfikacji\n`!setup-tickets` - UtwĂłrz panel ticketĂłw\n`!regulamin` - WyĹ›wietl regulamin', inline: false }
            )
            .setFooter({ text: 'Minecraft Clan Bot' })
            .setTimestamp();

        message.reply({ embeds: [helpEmbed] });
    }
});

// Event: Interakcje (przyciski)
client.on('interactionCreate', async (interaction) => {
    if (!interaction.isButton()) return;

    // Przycisk weryfikacji
    if (interaction.customId === 'verify') {
        const verifiedRole = interaction.guild.roles.cache.get(process.env.VERIFIED_ROLE_ID);
        
        if (!verifiedRole) {
            return interaction.reply({ content: 'âťŚ Rola zweryfikowanego nie zostaĹ‚a skonfigurowana!', ephemeral: true });
        }

        if (interaction.member.roles.cache.has(verifiedRole.id)) {
            return interaction.reply({ content: 'âś… JesteĹ› juĹĽ zweryfikowany!', ephemeral: true });
        }

        try {
            await interaction.member.roles.add(verifiedRole);
            
            const successEmbed = new EmbedBuilder()
                .setColor('#00FF00')
                .setTitle('âś… Weryfikacja pomyĹ›lna!')
                .setDescription('Witamy na serwerze! Teraz masz dostÄ™p do wszystkich kanaĹ‚Ăłw.')
                .setTimestamp();

            await interaction.reply({ embeds: [successEmbed], ephemeral: true });

            // Log
            const logsChannel = interaction.guild.channels.cache.get(process.env.LOGS_CHANNEL_ID);
            if (logsChannel) {
                const logEmbed = new EmbedBuilder()
                    .setColor('#00FF00')
                    .setTitle('âś… Nowa weryfikacja')
                    .setDescription(`${interaction.user.tag} (${interaction.user.id})`)
                    .setTimestamp();
                
                logsChannel.send({ embeds: [logEmbed] });
            }
        } catch (error) {
            console.error(error);
            interaction.reply({ content: 'âťŚ WystÄ…piĹ‚ bĹ‚Ä…d podczas weryfikacji!', ephemeral: true });
        }
    }

    // Przycisk tworzenia ticketu
    if (interaction.customId === 'create_ticket') {
        // SprawdĹş czy uĹĽytkownik ma juĹĽ otwarty ticket
        const existingTicket = activeTickets.get(interaction.user.id);
        if (existingTicket) {
            return interaction.reply({ content: `âťŚ Masz juĹĽ otwarte podanie: <#${existingTicket}>`, ephemeral: true });
        }

        try {
            // UtwĂłrz kanaĹ‚ ticketu
            const ticketChannel = await interaction.guild.channels.create({
                name: `podanie-${interaction.user.username}`,
                type: ChannelType.GuildText,
                parent: process.env.TICKET_CATEGORY_ID,
                permissionOverwrites: [
                    {
                        id: interaction.guild.id,
                        deny: [PermissionFlagsBits.ViewChannel]
                    },
                    {
                        id: interaction.user.id,
                        allow: [PermissionFlagsBits.ViewChannel, PermissionFlagsBits.SendMessages, PermissionFlagsBits.ReadMessageHistory]
                    },
                    {
                        id: process.env.MODERATOR_ROLE_ID,
                        allow: [PermissionFlagsBits.ViewChannel, PermissionFlagsBits.SendMessages, PermissionFlagsBits.ReadMessageHistory]
                    },
                    {
                        id: process.env.ADMIN_ROLE_ID,
                        allow: [PermissionFlagsBits.ViewChannel, PermissionFlagsBits.SendMessages, PermissionFlagsBits.ReadMessageHistory]
                    }
                ]
            });

            activeTickets.set(interaction.user.id, ticketChannel.id);

            const ticketEmbed = new EmbedBuilder()
                .setColor('#0099FF')
                .setTitle('đźŽ« Nowe podanie')
                .setDescription(`Witaj ${interaction.user}! DziÄ™kujemy za zainteresowanie naszym klanem.`)
                .addFields(
                    { name: 'đź“ť ProszÄ™ podaj:', value: 'â€˘ TwĂłj nick w Minecraft\nâ€˘ Wiek\nâ€˘ Poprzednie klany\nâ€˘ DoĹ›wiadczenie w grze\nâ€˘ Dlaczego chcesz doĹ‚Ä…czyÄ‡ do nas?\nâ€˘ Ile jesteĹ› w stanie wpĹ‚aciÄ‡ rubinĂłw na start?\nâ€˘ Ile robisz winĂłw dziennie/tygodniowo?', inline: false },
                    { name: 'âŹ±ď¸Ź Czas odpowiedzi', value: 'Odpowiemy w ciÄ…gu 3 godzin', inline: false }
                )
                .setFooter({ text: 'Aby zamknÄ…Ä‡ podanie, kliknij przycisk poniĹĽej' })
                .setTimestamp();

            const closeButton = new ActionRowBuilder()
                .addComponents(
                    new ButtonBuilder()
                        .setCustomId('close_ticket')
                        .setLabel('đź”’ Zamknij podanie')
                        .setStyle(ButtonStyle.Danger)
                );

            await ticketChannel.send({ content: `${interaction.user} <@&${process.env.MODERATOR_ROLE_ID}>`, embeds: [ticketEmbed], components: [closeButton] });

            await interaction.reply({ content: `âś… Utworzono podanie: ${ticketChannel}`, ephemeral: true });

            // Log
            const logsChannel = interaction.guild.channels.cache.get(process.env.LOGS_CHANNEL_ID);
            if (logsChannel) {
                const logEmbed = new EmbedBuilder()
                    .setColor('#0099FF')
                    .setTitle('đźŽ« Nowe podanie')
                    .setDescription(`${interaction.user.tag} utworzyĹ‚ podanie`)
                    .addFields({ name: 'KanaĹ‚', value: `${ticketChannel}`, inline: true })
                    .setTimestamp();
                
                logsChannel.send({ embeds: [logEmbed] });
            }
        } catch (error) {
            console.error(error);
            interaction.reply({ content: 'âťŚ Nie udaĹ‚o siÄ™ utworzyÄ‡ podania!', ephemeral: true });
        }
    }

    // Przycisk zamykania ticketu
    if (interaction.customId === 'close_ticket') {
        if (!interaction.member.permissions.has(PermissionFlagsBits.ManageChannels) && 
            !interaction.member.roles.cache.has(process.env.MODERATOR_ROLE_ID) &&
            !interaction.member.roles.cache.has(process.env.ADMIN_ROLE_ID)) {
            return interaction.reply({ content: 'âťŚ Tylko moderatorzy mogÄ… zamykaÄ‡ podania!', ephemeral: true });
        }

        const confirmEmbed = new EmbedBuilder()
            .setColor('#FFA500')
            .setTitle('âš ď¸Ź Potwierdzenie')
            .setDescription('Czy na pewno chcesz zamknÄ…Ä‡ to podanie?')
            .setTimestamp();

        const confirmButtons = new ActionRowBuilder()
            .addComponents(
                new ButtonBuilder()
                    .setCustomId('confirm_close')
                    .setLabel('âś… Tak, zamknij')
                    .setStyle(ButtonStyle.Danger),
                new ButtonBuilder()
                    .setCustomId('cancel_close')
                    .setLabel('âťŚ Anuluj')
                    .setStyle(ButtonStyle.Secondary)
            );

        await interaction.reply({ embeds: [confirmEmbed], components: [confirmButtons], ephemeral: true });
    }

    // Potwierdzenie zamkniÄ™cia
    if (interaction.customId === 'confirm_close') {
        try {
            // UsuĹ„ z mapy aktywnych ticketĂłw
            for (const [userId, channelId] of activeTickets.entries()) {
                if (channelId === interaction.channel.id) {
                    activeTickets.delete(userId);
                    break;
                }
            }

            await interaction.update({ content: 'đź”’ Zamykanie podania...', embeds: [], components: [] });
            
            // PrzenieĹ› do archiwum zamiast usuwaÄ‡
            const archiveCategoryId = process.env.TICKET_ARCHIVE_CATEGORY_ID;
            
            if (archiveCategoryId) {
                // PrzenieĹ› kanaĹ‚ do kategorii archiwum
                await interaction.channel.setParent(archiveCategoryId);
                
                // ZmieĹ„ nazwÄ™ na "zamkniÄ™te-"
                const newName = interaction.channel.name.replace('podanie-', 'zamkniÄ™te-');
                await interaction.channel.setName(newName);
                
                // Zablokuj wysyĹ‚anie wiadomoĹ›ci dla wszystkich oprĂłcz adminĂłw
                await interaction.channel.permissionOverwrites.edit(interaction.guild.id, {
                    SendMessages: false
                });
                
                // WyĹ›lij wiadomoĹ›Ä‡ o zamkniÄ™ciu
                const closedEmbed = new EmbedBuilder()
                    .setColor('#FF0000')
                    .setTitle('đź”’ Podanie zamkniÄ™te')
                    .setDescription(`Podanie zostaĹ‚o zamkniÄ™te przez ${interaction.user}`)
                    .setTimestamp();
                
                await interaction.channel.send({ embeds: [closedEmbed] });
            } else {
                // JeĹ›li nie ma kategorii archiwum, usuĹ„ kanaĹ‚ (stare zachowanie)
                setTimeout(async () => {
                    await interaction.channel.delete();
                }, 3000);
            }

            // Log
            const logsChannel = interaction.guild.channels.cache.get(process.env.LOGS_CHANNEL_ID);
            if (logsChannel) {
                const logEmbed = new EmbedBuilder()
                    .setColor('#FF0000')
                    .setTitle('đź”’ Podanie zamkniÄ™te')
                    .setDescription(`Podanie zostaĹ‚o zamkniÄ™te przez ${interaction.user.tag}`)
                    .addFields({ name: 'KanaĹ‚', value: interaction.channel.name, inline: true })
                    .setTimestamp();
                
                logsChannel.send({ embeds: [logEmbed] });
            }
        } catch (error) {
            console.error(error);
        }
    }

    // Anulowanie zamkniÄ™cia
    if (interaction.customId === 'cancel_close') {
        await interaction.update({ content: 'âś… Anulowano zamykanie podania.', embeds: [], components: [] });
    }
});

// Logowanie bota
client.login(process.env.DISCORD_TOKEN);

