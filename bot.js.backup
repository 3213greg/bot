                { name: 'đźź˘ Online', value: `${onlineMembers}`, inline: true },
                { name: 'đź‘¤ Ludzie', value: `${humans}`, inline: true },
                { name: 'đź¤– Boty', value: `${bots}`, inline: true },
                { name: 'đź“… Serwer utworzony', value: `<t:${Math.floor(message.guild.createdTimestamp / 1000)}:R>`, inline: true }
            )
