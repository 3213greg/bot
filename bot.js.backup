require('dotenv').config();
const { Client, GatewayIntentBits, Partials, EmbedBuilder, ActionRowBuilder, ButtonBuilder, ButtonStyle, PermissionFlagsBits, ChannelType } = require('discord.js');

const client = new Client({
    intents: [
        GatewayIntentBits.Guilds,
        GatewayIntentBits.GuildMembers,
        GatewayIntentBits.GuildMessages,
        GatewayIntentBits.MessageContent,
        GatewayIntentBits.GuildMessageReactions,
        GatewayIntentBits.GuildModeration
    ],
    partials: [Partials.Message, Partials.Channel, Partials.Reaction]
});

// Przechowywanie aktywnych ticketĂłw
const activeTickets = new Map();
const mutedUsers = new Map();

// Funkcja aktualizacji kanaĹ‚Ăłw statystyk
async function updateStatsChannels(guild) {
    try {
        const totalMembers = guild.memberCount;
        const onlineMembers = guild.members.cache.filter(m => m.presence?.status !== 'offline').size;
        const bots = guild.members.cache.filter(m => m.user.bot).size;

        // ZnajdĹş kanaĹ‚y statystyk (po nazwie)
        const channels = guild.channels.cache;
        
        // KanaĹ‚ z liczbÄ… czĹ‚onkĂłw
        const membersChannel = channels.find(c => c.name.includes('CzĹ‚onkĂłw:') || c.name.includes('STAN:'));
        if (membersChannel && membersChannel.type === ChannelType.GuildVoice) {
            await membersChannel.setName(`đź‘Ą CzĹ‚onkĂłw: ${totalMembers}`).catch(() => {});
        }

        // KanaĹ‚ z liczbÄ… online
        const onlineChannel = channels.find(c => c.name.includes('Online:'));
        if (onlineChannel && onlineChannel.type === ChannelType.GuildVoice) {
            await onlineChannel.setName(`đźź˘ Online: ${onlineMembers}`).catch(() => {});
        }

        // KanaĹ‚ z liczbÄ… botĂłw
        const botsChannel = channels.find(c => c.name.includes('BotĂłw:'));
        if (botsChannel && botsChannel.type === ChannelType.GuildVoice) {
            await botsChannel.setName(`đź¤– BotĂłw: ${bots}`).catch(() => {});
        }
    } catch (error) {
        console.error('BĹ‚Ä…d aktualizacji statystyk:', error);
    }
}

// Event: Bot gotowy
client.once('ready', () => {
    console.log(`âś… Bot zalogowany jako ${client.user.tag}`);
    console.log(`đź“Š Serwery: ${client.guilds.cache.size}`);
    console.log(`đź‘Ą UĹĽytkownicy: ${client.guilds.cache.reduce((a, g) => a + g.memberCount, 0)}`);
    
    // Ustaw status bota
    client.user.setActivity('đźŽ® Minecraft Clan', { type: 'WATCHING' });

    // Aktualizuj statystyki co 5 minut
    client.guilds.cache.forEach(guild => {
        updateStatsChannels(guild);
        setInterval(() => updateStatsChannels(guild), 5 * 60 * 1000);
    });
});

// Event: Nowy czĹ‚onek doĹ‚Ä…cza
client.on('guildMemberAdd', async (member) => {
    const welcomeChannel = member.guild.channels.cache.get(process.env.WELCOME_CHANNEL_ID);
    
    if (welcomeChannel) {
        const welcomeEmbed = new EmbedBuilder()
            .setColor('#00FF00')
            .setTitle('đź‘‹ Witamy na serwerze!')
            .setDescription(`Witaj ${member}! JesteĹ› **${member.guild.memberCount}** czĹ‚onkiem naszego klanu!`)
            .addFields(
                { name: 'đź“ś Regulamin', value: 'Przeczytaj regulamin w <#CHANNEL_ID>', inline: true },
                { name: 'âś… Weryfikacja', value: 'Zweryfikuj siÄ™ w <#CHANNEL_ID>', inline: true }
            )
            .setThumbnail(member.user.displayAvatarURL())
            .setTimestamp()
            .setFooter({ text: member.guild.name, iconURL: member.guild.iconURL() });
        
        welcomeChannel.send({ embeds: [welcomeEmbed] });
    }
    
    // Log do kanaĹ‚u administracyjnego
    const logsChannel = member.guild.channels.cache.get(process.env.LOGS_CHANNEL_ID);
    if (logsChannel) {
        const logEmbed = new EmbedBuilder()
            .setColor('#00FF00')
            .setTitle('đź“Ą Nowy czĹ‚onek')
            .setDescription(`${member.user.tag} (${member.id})`)
            .addFields(
                { name: 'Konto utworzone', value: `<t:${Math.floor(member.user.createdTimestamp / 1000)}:R>`, inline: true },
                { name: 'DoĹ‚Ä…czyĹ‚', value: `<t:${Math.floor(Date.now() / 1000)}:R>`, inline: true }
            )
            .setThumbnail(member.user.displayAvatarURL())
            .setTimestamp();
        
        logsChannel.send({ embeds: [logEmbed] });
    }

    // Aktualizuj statystyki
    updateStatsChannels(member.guild);
});

// Event: CzĹ‚onek opuszcza serwer
client.on('guildMemberRemove', async (member) => {
    const logsChannel = member.guild.channels.cache.get(process.env.LOGS_CHANNEL_ID);
    if (logsChannel) {
        const logEmbed = new EmbedBuilder()
            .setColor('#FF0000')
            .setTitle('đź“¤ CzĹ‚onek opuĹ›ciĹ‚ serwer')
            .setDescription(`${member.user.tag} (${member.id})`)
            .addFields(
                { name: 'DoĹ‚Ä…czyĹ‚', value: `<t:${Math.floor(member.joinedTimestamp / 1000)}:R>`, inline: true },
                { name: 'OpuĹ›ciĹ‚', value: `<t:${Math.floor(Date.now() / 1000)}:R>`, inline: true }
            )
            .setThumbnail(member.user.displayAvatarURL())
            .setTimestamp();
        
        logsChannel.send({ embeds: [logEmbed] });
    }

    // Aktualizuj statystyki
    updateStatsChannels(member.guild);
});

// Event: WiadomoĹ›ci (komendy)
client.on('messageCreate', async (message) => {
    if (message.author.bot) return;
    if (!message.content.startsWith('!')) return;

    const args = message.content.slice(1).trim().split(/ +/);
    const command = args.shift().toLowerCase();

    // Komenda: !setup-verification (tworzy panel weryfikacji)
    if (command === 'setup-verification') {
        if (!message.member.permissions.has(PermissionFlagsBits.Administrator)) {
            return message.reply('âťŚ Nie masz uprawnieĹ„ do tej komendy!');
        }

        const verificationEmbed = new EmbedBuilder()
            .setColor('#00FF00')
            .setTitle('âś… WERYFIKACJA')
            .setDescription('Kliknij przycisk poniĹĽej, aby zweryfikowaÄ‡ siÄ™ i uzyskaÄ‡ dostÄ™p do serwera!')
            .addFields(
                { name: 'đź“ś Zasady', value: 'â€˘ Przeczytaj regulamin\nâ€˘ BÄ…dĹş kulturalny\nâ€˘ Szanuj innych czĹ‚onkĂłw', inline: false }
            )
            .setFooter({ text: 'Kliknij przycisk aby siÄ™ zweryfikowaÄ‡' })
            .setTimestamp();

        const verifyButton = new ActionRowBuilder()
            .addComponents(
                new ButtonBuilder()
                    .setCustomId('verify')
                    .setLabel('âś… Zweryfikuj siÄ™')
                    .setStyle(ButtonStyle.Success)
            );

        await message.channel.send({ embeds: [verificationEmbed], components: [verifyButton] });
        message.delete().catch(() => {});
    }

    // Komenda: !setup-tickets (tworzy panel ticketĂłw)
    if (command === 'setup-tickets') {
        if (!message.member.permissions.has(PermissionFlagsBits.Administrator)) {
            return message.reply('âťŚ Nie masz uprawnieĹ„ do tej komendy!');
        }

        const ticketEmbed = new EmbedBuilder()
            .setColor('#0099FF')
            .setTitle('đźŽ« SYSTEM PODAĹ')
            .setDescription('Kliknij przycisk poniĹĽej, aby utworzyÄ‡ podanie do klanu!')
            .addFields(
                { name: 'đź“ť Co zawrzeÄ‡ w podaniu?', value: 'â€˘ TwĂłj nick w Minecraft\nâ€˘ Wiek\nâ€˘ Poprzednie klany\nâ€˘ DoĹ›wiadczenie w grze\nâ€˘ Dlaczego chcesz doĹ‚Ä…czyÄ‡ do nas?\nâ€˘ Ile jesteĹ› w stanie wpĹ‚aciÄ‡ rubinĂłw na start?\nâ€˘ Ile robisz winĂłw dziennie/tygodniowo?', inline: false },
                { name: 'âŹ±ď¸Ź Czas odpowiedzi', value: 'Odpowiemy w ciÄ…gu 3 godzin', inline: false }
            )
            .setFooter({ text: 'Kliknij przycisk aby utworzyÄ‡ podanie' })
            .setTimestamp();

        const ticketButton = new ActionRowBuilder()
            .addComponents(
                new ButtonBuilder()
                    .setCustomId('create_ticket')
                    .setLabel('đź“ť UtwĂłrz podanie')
                    .setStyle(ButtonStyle.Primary)
            );

        await message.channel.send({ embeds: [ticketEmbed], components: [ticketButton] });
        message.delete().catch(() => {});
    }

    // Komenda: !members (liczba czĹ‚onkĂłw)
    if (command === 'members' || command === 'czĹ‚onkowie') {
        const totalMembers = message.guild.memberCount;
        const onlineMembers = message.guild.members.cache.filter(m => m.presence?.status !== 'offline').size;
        const bots = message.guild.members.cache.filter(m => m.user.bot).size;
        const humans = totalMembers - bots;

        const statsEmbed = new EmbedBuilder()
            .setColor('#0099FF')
